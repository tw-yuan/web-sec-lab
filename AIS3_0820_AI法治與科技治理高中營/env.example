# 複製這個檔為 .env 後填入你自己的值。.env 內含機密，切勿 commit 進 git。

DATA_DIR=/srv/data
CHALLENGES_PATH=/srv/challenges.json

APP_PORT=8002
APP_BIND=0.0.0.0

# --- 機密：請務必改成你自己的值 ---
# 後台 /admin.html 的權杖，用夠長的隨機字串（例：openssl rand -hex 24）
ADMIN_TOKEN=change-me-please
# per-user flag 的推導金鑰，必須跨重啟穩定；換掉會讓所有已發出的 flag 失效（例：openssl rand -hex 32）
SERVER_SECRET=change-me-to-a-random-64-hex-string
# OpenRouter 金鑰，只留在後端，永不下發前端
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# LLM
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
HTTP_REFERER=https://example.org
X_TITLE=NCSE AI Security CTF
FAKE_LLM=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONCURRENCY=32
LLM_MAX_RETRIES=2
GLOBAL_TOKEN_BUDGET=0
BUDGET_WARN_RATIO=0.8

# Session / users
SESSION_TTL_SECONDS=86400
# 首次啟動時，DB 為空會自動建立這麼多組參賽代碼
SEED_USERS=80

# Limits（0 = 不限）
MAX_DOCUMENT_CHARS=4000
MAX_HISTORY_MESSAGES=6
MAX_USER_MESSAGE_CHARS=2000
MAX_DEFENSE_PROMPT_CHARS=4000
MAX_ATTEMPTS_PER_CHALLENGE=0

# Rate limiting（0 = 不限）
RATE_PER_CHALLENGE_PER_MIN=0
RATE_LOGIN_PER_MIN=0
RATE_PER_USER_PER_MIN=0
DEF_RATE_PER_MIN=0

# Challenge defaults
DEF_REQUIRE_USABILITY=1
DEF_MAX_SUBMISSIONS=0
FINAL_OPEN_DEFAULT=0
XSS_NONCE_TTL_SECONDS=900
